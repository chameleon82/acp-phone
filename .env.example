# Keep this file secret. Do not commit a real .env file.
OPENAI_API_KEY=
# Required. Set your configured API gateway endpoint.
OPENAI_BASE_URL=
ACP_PHONE_PORT=3000
# HTTPS starts alongside HTTP when certificate and key files are available.
ACP_PHONE_HTTPS_PORT=3443
# Optional paths relative to the configuration directory; defaults shown below.
# ACP_PHONE_TLS_CERT=.acp-phone/tls/cert.pem
# ACP_PHONE_TLS_KEY=.acp-phone/tls/key.pem
ACP_PHONE_CONFIG=./acp-phone.config.json
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_REPLY_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
