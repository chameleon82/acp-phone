# Keep this file secret. Do not commit a real .env file.
OPENAI_API_KEY=
# Optional. Leave blank to use the official OpenAI API endpoint (https://api.openai.com/v1).
OPENAI_BASE_URL=https://api.openai.com/v1
ACP_PHONE_PORT=3000
ACP_PHONE_CONFIG=./acp-phone.config.json
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_REPLY_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
