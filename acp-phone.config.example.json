{
  "listener": {
    "host": "127.0.0.1",
    "port": 3000
  },
  "limits": {
    "maxAudioBytes": 10485760
  },
  "targets": [
    {
      "id": "local-codex",
      "label": "Local Codex Agent",
      "command": "codex-acp",
      "args": [],
      "cwd": "."
    },
    {
      "id": "local-claude",
      "label": "Local Claude Agent",
      "command": "claude-agent-acp",
      "args": [],
      "cwd": "."
    },
    {
      "id": "remote-agent",
      "label": "Remote ACP Agent",
      "transport": "http",
      "baseUrl": "https://remote-acp.example.invalid",
      "headers": {
        "X-Client-Name": "acp-phone"
      },
      "headerEnv": {
        "Authorization": "ACP_PHONE_REMOTE_AUTHORIZATION"
      },
      "session": {
        "mode": "create-per-call",
        "createPath": "/acp/v1/sessions",
        "messagePathTemplate": "/acp/v1/sessions/{sessionId}/messages",
        "eventsPathTemplate": "/acp/v1/sessions/{sessionId}/sse",
        "historyPathTemplate": "/acp/v1/sessions/{sessionId}/events",
        "createBody": {
          "agent": "configured-agent",
          "cwd": "."
        }
      }
    }
  ]
}
